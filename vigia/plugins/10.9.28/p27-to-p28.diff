+        if (($conv['conversation_owner']??'')!=='LUNA' || !empty($conv['human_hold']) || !empty($conv['opt_out'])) return;
+        $sent_ts=strtotime((string)($row['sent_at']??'').' UTC');
+        $in_ts=!empty($conv['last_inbound_at'])?strtotime((string)$conv['last_inbound_at'].' UTC'):0;
+        if ($in_ts && (!$sent_ts || $in_ts>=$sent_ts)) return;
