+    private static function effective_initial(string $lead_id,string $phone): ?array {
+        $base=hash('sha256','INITIAL|'.$lead_id.'|'.$phone);
+        $first=WFCA_DB::get_outbox_by_idempotency_key($base);
+        if (!$first) return null;
+        $chain=[$first];
