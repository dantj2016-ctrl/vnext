+        $latest=WFCA_DB::get_outbox_by_idempotency_key(hash('sha256','INITIAL|'.$lead_id.'|'.$phone));
+        $next=1;
+        if ($latest) {
+            for ($n=1;$n<=$max+1;$n++) { $r=WFCA_DB::get_outbox_by_idempotency_key(self::d0_retry_key($lead_id,$phone,$n)); if (!$r) { $next=$n;break; } $latest=$r;$next=$n+1; }
