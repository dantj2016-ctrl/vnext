+        $fresh=WFCA_DB::upsert_conversation($phone,['state'=>$target,'human_hold'=>0,'summary'=>'AUTO_RECOVERED_TRANSIENT_OUTBOX']);
+        WFCA_Ownership::sync((int)$conv['id']);
+        $remote=['State'=>$target,'Human Handoff Reason'=>'','Commercial Error'=>'','Conversation Summary'=>'Auto-recovered after transient provider/infra failure ('.WFCA_Util::short_text($err,60).'); no prospect reply.'];
