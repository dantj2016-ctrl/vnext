+        global $wpdb;
+        $rows=$wpdb->get_results($wpdb->prepare("SELECT o.* FROM ".self::t('outbox')." o JOIN ".self::t('conversations')." c ON c.id=o.conversation_id
+            WHERE c.phone_e164=%s AND o.status='UNCERTAIN' AND o.action_type='TEMPLATE_INITIAL' AND o.provider_message_id IS NULL AND o.sent_at IS NULL
+              AND o.send_started_at IS NOT NULL AND o.send_started_at<=%s AND o.send_started_at>=%s LIMIT 2",
