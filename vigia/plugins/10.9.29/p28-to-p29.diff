+
+    /**
+     * 10.9.29: SMTP/Kapso-independent channel for CRITICAL alerts. Always (options only, no network): option wfca_alerts_ring = last 50 CRITICAL
+     * alerts (exposed in /commercial/health -> health_v1.critical_alerts, so a watchdog needs ONE call). The Airtable mirror and the direct
+     * owner e-mail are NOT done here (a slow Airtable would stretch the caller): flush_ring() does at most 2 per tick, one entry per alert key.
+     */
+    private static function ring_push(string $reason,string $lead_id,int $conversation_id,string $source_key): void {
+        try {
+            if (empty(WFCA_Util::rules()['alerts_ring_enabled'])) return;
+            $h=substr(hash('sha256',$source_key),0,12);
+            $ring=get_option('wfca_alerts_ring',[]); if (!is_array($ring)) $ring=[];
+            foreach ($ring as $r) if (is_array($r) && ($r['k']??'')===$h) return; // same alert key: already recorded
+            $ring[]=['k'=>$h,'at'=>gmdate('c'),'reason'=>WFCA_Util::redact_error($reason,120),'lead'=>$lead_id,'conv'=>$conversation_id,'mirrored'=>$conversation_id>0?0:1,'mailed'=>0];
+            update_option('wfca_alerts_ring',array_slice($ring,-50),false);
+        } catch (\Throwable $e) {}
+    }
+
+    public static function ring_tail(int $n=10): array {
+        $ring=get_option('wfca_alerts_ring',[]);
+        return is_array($ring)?array_slice($ring,-$n):[];
+    }
+
+    /**
+     * Called once per tick. (1) conversation alerts: write 'Commercial Error' = ALERT CRITICAL ... on the Airtable conversation (existing field, no new
+     * table). (2) alerts without a conversation (they never reach the outbox e-mail, see enqueue()): one direct wp_mail to the owner.
+     * Both are best effort, never throw, stop at the first failure (the entry stays pending and is retried next tick; entries older than 24 h give up).
+     */
+    public static function flush_ring(int $max=2): void {
+        try {
+            $rules=WFCA_Util::rules();
+            if (empty($rules['alerts_ring_enabled'])) return;
+            $ring=get_option('wfca_alerts_ring',[]); if (!is_array($ring) || !$ring) return;
+            $done=0;$dirty=false;
+            foreach ($ring as $i=>$r) {
+                if ($done>=$max) break;
+                if (!is_array($r) || strtotime((string)($r['at']??''))<time()-86400) continue;
+                if (empty($r['mirrored']) && !empty($rules['alerts_airtable_mirror'])) {
+                    $c=WFCA_DB::get_conversation((int)$r['conv']);
+                    $ok=$c && !empty($c['phone_e164']) && !empty(WFCA_Airtable::update_commercial_by_phone((string)$c['phone_e164'],['Commercial Error'=>WFCA_Util::short_text('ALERT CRITICAL '.$r['reason'].' @ '.$r['at'],400)])['ok']);
+                    $done++;
+                    if (!$ok) break;
+                    $ring[$i]['mirrored']=1;$dirty=true;
+                } elseif (empty($r['mailed']) && (int)$r['conv']===0 && !empty($rules['alerts_direct_mail']) && WFCA_Util::owner_email()!=='') {
+                    $ring[$i]['mailed']=1;$dirty=true;$done++; // mark first: a hanging SMTP must not be retried every tick
+                    update_option('wfca_alerts_ring',$ring,false);
+                    wp_mail(WFCA_Util::owner_email(),'[Website Factory] CRITICAL','CRITICAL: '.$r['reason'].' @ '.$r['at']);
+                }
+            }
+            if ($dirty) update_option('wfca_alerts_ring',$ring,false);
+        } catch (\Throwable $e) {}
+    }
