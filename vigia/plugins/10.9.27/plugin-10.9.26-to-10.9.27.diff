-        $resolved=0;$failed=0;
+        // 10.9.27: a failed row whose provider code is recipient-side (default 130472 experiment / 131026 undeliverable) says nothing about our
+        // sender quality, so it is left out of BOTH sides of the ratio. Unknown/missing code (legacy rows, odd payloads) still counts as a failure.
+        $rows=$wpdb->get_results($wpdb->prepare("SELECT o.delivery_status, CASE WHEN o.delivery_status='failed' THEN (SELECT e.body FROM ".WFCA_DB::t('events')." e WHERE e.provider_message_id=o.provider_message_id AND e.event_type='DELIVERY_FAILED' ORDER BY e.id DESC LIMIT 1) END AS fail_body FROM ".WFCA_DB::t('outbox')." o WHERE o.action_type='TEMPLATE_INITIAL' AND o.status='SENT' AND o.sent_at>%s ORDER BY o.id DESC LIMIT 10",gmdate('Y-m-d H:i:s',$since)),ARRAY_A)?:[];
+        $ignore=array_map('strval',(array)($rules['d0_delivery_brake_ignore_codes']??[]));
+        $resolved=0;$failed=0;$ignored=0;
         foreach ($rows as $r) {
             $st=strtolower((string)($r['delivery_status']??''));
+            if ($st==='failed' && $ignore) {
+                $code=WFCA_Util::delivery_fail_code_digits((string)($r['fail_body']??''));
+                if ($code!=='' && in_array($code,$ignore,true)) { $ignored++; continue; }
+            }
             if (in_array($st,['delivered','read','failed'],true)) { $resolved++; if ($st==='failed') $failed++; }
         }
         if ($resolved<6) return false;
         if ($failed/$resolved<=(float)$rules['d0_delivery_brake_failure_ratio']) return false;
         update_option('wfca_d0_brake_until',time()+3600,false);
         update_option('wfca_d0_brake_released_at',time()+3600,false);
-        WFCA_Alerts::raise('D0_DELIVERY_BRAKE:'.$failed.'/'.$resolved.'_FAILED','CRITICAL','',0,0,'','d0brake:'.gmdate('YmdH'));
+        WFCA_Alerts::raise('D0_DELIVERY_BRAKE:'.$failed.'/'.$resolved.'_FAILED'.($ignored?'+'.$ignored.'_RECIPIENT_SIDE_IGNORED':''),'CRITICAL','',0,0,'','d0brake:'.gmdate('YmdH'));
         return true;
     }
 
