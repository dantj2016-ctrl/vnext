+    /** Read-only diagnostic counters of delivery failures by provider error code. Never read by any send decision or gate. */
+    public static function delivery_fail_code(string $body): string {
+        if (preg_match('/^WA_ERR code=([A-Za-z0-9_.\-]{1,12})/',$body,$m)) return 'code_'.$m[1];
+        return 'NO_DETAIL';
+    }
+
+    public static function record_delivery_failure(string $body,string $phone='',?int $now=null): void {
+        try {
+            $now=$now??time();
+            $key=self::delivery_fail_code($body);
+            $o=get_option('wfca_delivery_fail_counters',[]);
+            if (!is_array($o)) $o=[];
+            $codes=is_array($o['codes']??null)?$o['codes']:[];
+            $days=is_array($o['days']??null)?$o['days']:[];
+            if (!isset($codes[$key]) && count($codes)>=40) $key='code_OTHER';
+            $prev=is_array($codes[$key]??null)?$codes[$key]:[];
+            $codes[$key]=['count'=>(int)($prev['count']??0)+1,'last_at'=>gmdate('Y-m-d\TH:i:s\Z',$now),'last_tail4'=>substr(preg_replace('/\D+/','',$phone),-4)];
+            $day=gmdate('Y-m-d',$now);
+            $days[$day][$key]=(int)($days[$day][$key]??0)+1;
+            ksort($days);
+            $days=array_slice($days,-7,null,true);
+            update_option('wfca_delivery_fail_counters',['codes'=>$codes,'days'=>$days],false);
+        } catch (\Throwable $e) {}
+    }
+
+    public static function delivery_fail_counters(): array {
+        try {
+            $o=get_option('wfca_delivery_fail_counters',[]);
+            return is_array($o)?['codes'=>(array)($o['codes']??[]),'days'=>(array)($o['days']??[])]:['codes'=>[],'days'=>[]];
+        } catch (\Throwable $e) { return ['codes'=>[],'days'=>[]]; }
+    }
